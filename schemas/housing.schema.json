{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JWHV housing",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_name",
    "source_url",
    "first_seen",
    "last_seen",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "prefecture": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "nearest_station": {
      "type": [
        "string",
        "null"
      ]
    },
    "monthly_rent_display": {
      "type": [
        "string",
        "null"
      ]
    },
    "minimum_stay": {
      "type": [
        "string",
        "null"
      ]
    },
    "furnished": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "guarantor_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "foreigner_eligibility": {
      "enum": [
        "explicitly_accepted",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "first_seen": {
      "type": "string",
      "format": "date"
    },
    "last_seen": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "active",
        "stale",
        "expired"
      ]
    }
  }
}
